{
  "crons": [
    {
      "path": "/api/binmaster-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/barntools-sync",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/ap-sync",
      "schedule": "30 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(binmaster|barntools|ap)-data",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
